pipeline {
    agent any

    environment {
        IMAGE_NAME   = "yaswanth032/zomato"
        CLUSTER_NAME = "task8-zomato-eks"
        AWS_REGION   = "ap-south-1"
    }

    stages {

        stage('Delete Existing EKS') {
            steps {
                sh '''
                    if aws eks describe-cluster \
                        --name "$CLUSTER_NAME" \
                        --region "$AWS_REGION" >/dev/null 2>&1; then

                        echo "Existing EKS cluster found. Deleting..."
                        eksctl delete cluster \
                            --name "$CLUSTER_NAME" \
                            --region "$AWS_REGION" \
                            --wait
                    else
                        echo "No existing EKS cluster found."
                    fi
                '''
            }
        }

        stage('Create EKS') {
            steps {
                sh '''
                    eksctl create cluster \
                        --name "$CLUSTER_NAME" \
                        --region "$AWS_REGION" \
                        --version 1.33 \
                        --nodegroup-name task8-ng \
                        --node-type t3.small \
                        --nodes 2 \
                        --nodes-min 2 \
                        --nodes-max 2 \
                        --vpc-public-subnets subnet-0aafd115bc162983d,subnet-0f89a0e6a02631cdf,subnet-0b081c5fb2d76d65c
                '''
            }
        }

        stage('Git Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/PutluruLikhitha/DevOps-Project-Zomato-Kastro.git'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t $IMAGE_NAME:latest .'
            }
        }

        stage('DockerHub Push') {
            steps {
                withDockerRegistry(credentialsId: 'docker', url: 'https://index.docker.io/v1/') {
                    sh 'docker push $IMAGE_NAME:latest'
                }
            }
        }

        stage('Configure EKS') {
            steps {
                sh '''
                    aws eks update-kubeconfig \
                        --region "$AWS_REGION" \
                        --name "$CLUSTER_NAME"
                '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh '''
                    kubectl apply -f Kubernetes/deployment.yaml
                    kubectl apply -f Kubernetes/service.yaml
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    kubectl rollout status deployment/zomato --timeout=300s
                    kubectl get pods
                    kubectl get svc zomato
                '''
            }
        }
    }

    post {
        success {
            echo 'TASK-8 SUCCESS: EKS + Git + Docker + Jenkins + Kubernetes deployment completed.'
        }

        failure {
            echo 'TASK-8 FAILED. Check the failed stage in Jenkins.'
        }
    }
}
